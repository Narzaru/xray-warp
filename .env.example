# Основной домен (без www)
DOMAIN=example.com

# Email для уведомлений Let's Encrypt
EMAIL=admin@example.com

# Часовой пояс — если не задан, определяется автоматически по системе
# (список: timedatectl list-timezones)
# TIMEZONE=Europe/Moscow

# Порт SSH на хосте (sslh будет слушать 443 и перенаправлять SSH сюда)
SSH_PORT=22

# ── Проксирование исходящего трафика XRay ────────────────────────────────────
# Весь трафик клиентов XRay пойдёт через прокси перед выходом в интернет.
# Значения: off | warp | vps
PROXY_MODE=off

# Для PROXY_MODE=vps — параметры подключения к удалённому серверу (VLESS/TCP/TLS)
# VPS_ADDRESS=1.2.3.4
# VPS_PORT=443
# VPS_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VPS_SNI=example.com           # SNI для TLS (обычно домен или IP VPS)

# ── Hysteria2 — транспорт QUIC/UDP для каналов с потерями ────────────────────
# Ставится рядом с основным стеком на порт 443/udp, ничего не переназначая.
# Нужен там, где TCP не тянет из-за потерь пакетов (мобильные сети).
# Значения: off | on
HYSTERIA=off

# Пароли клиентов. Оставьте пустыми — скрипт сгенерирует их при первой установке
# и допишет сюда сам. Заданные значения он не трогает, чтобы переустановка
# не сбрасывала доступ у уже настроенных клиентов.
# HYSTERIA_PASS_YAROSLAV=
# HYSTERIA_PASS_MAMA=
# HYSTERIA_PASS_PAPA=
