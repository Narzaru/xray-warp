{
  "outbounds": [
    {
      "tag": "vps-out",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "${VPS_ADDRESS}",
            "port": ${VPS_PORT},
            "users": [
              {
                "id": "${VPS_UUID}",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "${VPS_SNI}",
          "allowInsecure": false
        }
      }
    }
  ]
}
